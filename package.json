{
  "name": "programa-formar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\" && npm run db:seed",
    "fontes": "node scripts/woff-para-ttf.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "admin": "tsx --conditions=react-server --env-file=.env.local scripts/criar-admin.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.production.local scripts/migrar.ts",
    "db:verificar": "tsx --env-file-if-exists=.env.production.local scripts/verificar-banco.ts",
    "contas-teste": "tsx --conditions=react-server --env-file=.env.local scripts/contas-teste.ts",
    "contas-teste:producao": "tsx --conditions=react-server --env-file=.env.production.local scripts/contas-teste.ts",
    "admin:producao": "tsx --conditions=react-server --env-file=.env.production.local scripts/criar-admin.ts",
    "publicar": "powershell -ExecutionPolicy Bypass -File scripts/publicar-aws.ps1",
    "publicar:primeira": "powershell -ExecutionPolicy Bypass -File scripts/publicar-aws.ps1 -Primeira",
    "chave": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1171.0",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
