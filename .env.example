# Modelo de variáveis. Desenvolvimento: rode `npm run setup` (gera .env.local).
# Produção: no seu PC, copie para .env.production.local (nunca versionar); na AWS, configure no painel.

# Banco (Supabase, São Paulo): pooler compartilhado em modo SESSÃO, porta 5432.
# Usuário no formato postgres.<referência-do-projeto>. Copie em "Connect" no painel do Supabase.
DATABASE_URL=postgresql://postgres.REFERENCIA:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Certificado do banco: caminho do arquivo .crt (no PC) ou o conteúdo PEM em uma linha com \n (na AWS).
DATABASE_CA_CERT=C:\caminho\seguro\supabase-ca.crt
DATABASE_POOL_MAX=5

# Chaves de 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NÃO trocar depois de ter dados (o CPF cifrado deixaria de ser lido). Guarde cópia no cofre de senhas.
CPF_HMAC_KEY=
CPF_ENC_KEY=

SITE_URL=https://programaformar.example

# Segredo que a Cloudflare envia no cabeçalho x-origem-formar (Transform Rule). Sem ele, o site responde 403.
# Gere com o mesmo comando das chaves acima.
ORIGEM_SEGREDO=

# E-mail pelo Amazon SES (ver docs/implantacao.md).
# Enquanto o SES não estiver liberado, use EMAIL_MODO=fila (as mensagens ficam guardadas, nada sai).
EMAIL_MODO=ses
SES_REGIAO=sa-east-1
SES_REMETENTE=Programa Formar <nao-responda@programaformar.example>
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
